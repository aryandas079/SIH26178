{
  "name": "erms-enterprise-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ERMS Enterprise Multi-Tier Environmental Risk Intelligence Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/start_dev_all.mjs",
