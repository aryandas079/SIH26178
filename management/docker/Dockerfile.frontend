# =====================================================================
# ERMS Multi-Stage Production Frontend Dockerfile
# Stage 1: Build the React 18 / Vite client bundle
# Stage 2: Serve optimized static assets with high-performance Nginx
# =====================================================================

# Stage 1: Build Environment
FROM node:20-alpine AS builder
WORKDIR /app

# Copy root & frontend package definitions
COPY package*.json ./
COPY frontend/package*.json ./frontend/

# Install build dependencies
RUN npm install

# Copy frontend source code
COPY frontend/ ./frontend/
COPY database/ ./database/

# Build production distribution
WORKDIR /app/frontend
RUN npm run build

# Stage 2: Production Web Server
FROM nginx:alpine AS runner
WORKDIR /usr/share/nginx/html

# Remove default nginx static assets
RUN rm -rf ./*

# Copy compiled assets from builder stage
COPY --from=builder /app/frontend/dist .

# Copy production Nginx reverse proxy configuration
COPY management/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
